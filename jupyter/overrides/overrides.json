{
  "@jupyterlab/docmanager-extension:plugin": {
    "defaultViewers": {
      "sql": "Jupytext Notebook",
      "python": "Jupytext Notebook"
    }
  },
  "@jupyterlab/apputils-extension:notification": {
    "fetchNews": "false",
    "checkForUpdates": false
  },
  "@jupyterlab/filebrowser-extension:widget": {
    "toolbar": [
      {"name": "gitClone", "disabled": true}
    ]
  },
  "@jupyterlab/notebook-extension:panel": {
    "toolbar": [
      {"name": "kernelName", "disabled": true}
    ]
  },
  "@jupyterlab/mainmenu-extension:plugin": {
    "menus": [
      {"id": "jp-mainmenu-git", "disabled": true},
      {"id": "jp-mainmenu-tabs", "disabled": true},
      {"id": "jp-mainmenu-kernel", "disabled": true},
      {"id": "jp-mainmenu-edit", "items": [
        {"command": "notebook:move-cell-up", "disabled": true},
        {"command": "notebook:move-cell-down", "disabled": true},
        {"command": "notebook:delete-cell", "disabled": true}
      ]},
      {"id": "jp-mainmenu-file", "items": [
        {"type": "submenu", "submenu": {"id": "jp-mainmenu-file-new", "items": [
          {"command": "console:create", "disabled": true}
        ]}},
        {"command": "filemenu:create-console", "disabled": true},
        {"command": "application:close", "disabled": true},
        {"command": "filemenu:close-and-cleanup", "disabled": true},
        {"command": "application:close-all", "disabled": true},
        {"command": "apputils:print", "disabled": true}
      ]},
      {"id": "jp-mainmenu-run", "items": [
        {"command": "notebook:run-in-console", "disabled": true}
      ]},
      {"id": "jp-mainmenu-view", "items": [
        {"type": "submenu", "submenu": {"id": "jp-mainmenu-view-codemirror-language"}, "disabled": true}
      ]},
      {"id": "jp-mainmenu-settings", "items": [
        {"type": "submenu", "submenu": {"id": "jp-mainmenu-settings-consoleexecute"}, "disabled": true},
        {"type": "submenu", "submenu": {"id": "jp-mainmenu-settings-apputilstheme"}, "disabled": true},
        {"type": "submenu", "submenu": {"id": "jp-mainmenu-settings-language"}, "disabled": true},
        {"type": "submenu", "submenu": {"id": "jp-mainmenu-settings-codemirror-theme"}, "disabled": true}
      ]}
    ]
  },
  "@jupyterlab/application-extension:context-menu": {
    "contextMenu": [
      {"command": "filemenu:create-console", "selector": "[data-type=\"document-title\"].jp-mod-current", "disabled": true},
      {"command": "fileeditor:create-console", "selector": ".jp-FileEditor", "disabled": true},
      {"command": "notebook:create-console", "selector": ".jp-Notebook", "disabled": true},
      {"command": "notebook:create-subshell-console", "selector": ".jp-Notebook", "disabled": true}
    ]
  }
}
