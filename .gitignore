# OS files
.DS_Store
Thumbs.db

# Podman / container artifacts
*.tar

# Grafana provisioning rendered from templates by build.sh (see grafana/render.sh)
grafana/.provisioning/

# Django
staticfiles/

# SQLMesh writes its own log files next to the project when it is run from the host.
# In the container they go to /tmp instead (see sqlmesh/entrypoint.sh) and the engine
# logs to stdout, so these are only a local artefact and must not reach the image.
sqlmesh/logs/

# Parsed models and query plans SQLMesh caches next to the project to speed up the next
# command. Rebuilt on demand, and specific to the machine that ran it.
sqlmesh/.cache/

# The database password SQLMesh connects with when it is run from a developer's machine.
# SQLMesh loads this file itself (see sqlmesh/config.py). It holds a secret, so unlike
# buildtime.env and runtime.env it is never committed and never copied into the image.
sqlmesh/.env
