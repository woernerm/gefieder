# One server-statistics sample, fired by the companion timer. It runs on the host as the
# rootless-podman user rather than as a container, because only the host can read the pod's
# cgroup counters, disk IOPS and network egress, and reaches the database with
# `podman exec postgresql` rather than over a published port.
#
# install.sh puts it under ~/.config/systemd/user/ beside the quadlet-generated units, and
# renders ${APP_NAME} as it does for those.
[Unit]
Description=${APP_NAME} server-statistics sample
# A hint, not a hard dependency: a tick that runs while the database is down simply fails
# and the next one succeeds.
After=main-pod.service
Wants=main-pod.service

[Service]
Type=oneshot
# The collector derives its state directory from the app name.
Environment=APP_NAME=${APP_NAME}
# The role, database and schema. Passed rather than left to the collector's fallbacks,
# which fit only a deployment that kept every default.
Environment=POSTGRES_USER=${SUPERUSER_NAME}
Environment=POSTGRES_DB=${PG_DATABASE}
Environment=SERVER_STATS_SCHEMA=${SERVER_STATS_SCHEMA}
ExecStart=%h/.config/${APP_NAME}/serverstats/collect.sh
