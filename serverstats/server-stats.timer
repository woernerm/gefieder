# Fires the server-statistics sample on a fixed cadence. The interval is
# SERVER_STATS_INTERVAL, substituted into OnUnitActiveSec when the release is rendered:
# systemd reads a cadence only from the unit file, never from an environment file. To change
# it on an installed machine, edit OnUnitActiveSec and run `systemctl --user daemon-reload`.
[Unit]
Description=${APP_NAME} server-statistics sampling timer

[Timer]
# The first sample shortly after boot, then one per interval. Persistent=true runs a missed
# one once the machine comes back, so a reboot leaves no permanent gap.
OnBootSec=2min
OnUnitActiveSec=${SERVER_STATS_INTERVAL}s
Persistent=true

[Install]
WantedBy=timers.target
