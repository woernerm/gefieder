# Production configuration: everything is served over TLS, plain HTTP requests are
# permanently redirected to HTTPS.

# --- dashboard/page visit logging -----------------------------------------------------
# A structured, filtered access log used for usage statistics (which dashboard is visited,
# when, by which session). It is deliberately separate from the access log nginx writes to
# stdout for journald, and records only real page navigations, because a single dashboard
# view triggers dozens of API, asset and live-poll requests that would otherwise inflate
# every count. The maps below classify each request; only those tagged with an app are
# logged. The collector drains this file into server_stats.dashboard_visit.

# Tag a request with the app it is a page visit for, or "" to skip it. Grafana renders a
# dashboard at /${GRAFANA_PATH}/d/<uid>/<slug> (and /d-solo for a single panel); its panel
# data, assets and live updates are under /api, /public, /avatar, ... and are skipped.
# crudman (Django admin) serves its pages directly under /${CRUDMAN_PATH}/; its static
# files live under /${CRUDMAN_PATH}/static/ and are skipped.
map $uri $visit_app {
    default                              "";
    ~^/${GRAFANA_PATH}/d-solo/           grafana;
    ~^/${GRAFANA_PATH}/d/                grafana;
    ~^/${CRUDMAN_PATH}/static/           "";   # assets, not a page view
    ~^/${CRUDMAN_PATH}/                  crudman;
}

# Only GET requests are page views; a POST is a form submit/login, not a visit.
map $request_method $visit_is_get {
    default  0;
    GET      1;
}

# The final gate: log only when the request is a GET and matched an app. The value is the
# app name (non-empty => logged via the "if=$visit_log" below), or "" to drop the line.
map "$visit_is_get:$visit_app" $visit_log {
    default        "";
    ~^1:(.+)$      $1;
}

# One JSON object per visit. escape=json keeps user-controlled fields (the path, the
# user-agent) from breaking the JSON. The session cookie is logged raw here -- the log
# lives on the proxy's own volume, owned by the rootless podman user -- and the collector
# hashes it before storing, so the raw value is never persisted in the database. $remote_addr
# is the direct client; $http_x_forwarded_for carries the original client behind any proxy.
log_format visit_json escape=json
    '{"ts":"$time_iso8601","app":"$visit_app","path":"$uri",'
    '"status":$status,"ip":"$remote_addr","xff":"$http_x_forwarded_for",'
    '"ua":"$http_user_agent",'
    '"grafana_session":"$cookie_grafana_session","crudman_session":"$cookie_sessionid"}';

# --- WebSocket handshakes ---------------------------------------------------------------
# The value for the Connection header sent upstream: "upgrade" for a handshake, "close" for
# an ordinary request, which must not carry one. See the grafana location below.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    # Named without a port, so it points at 443. A deployment that publishes HTTPS on
    # another port (see "Using custom ports" in the README) has to name it here.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    # Also accept IPv6, which a company network's DNS may well answer with. The entrypoint
    # drops this line on a host whose kernel offers no IPv6, where nginx would refuse to
    # start over an address family it cannot bind.
    listen [::]:443 ssl;

    # Answer redirects with a path rather than a full URL. nginx builds an absolute one from
    # the port it listens on inside the pod, not the one the request arrived on, so any
    # deployment that publishes something other than 80/443 -- dev.sh, or the custom ports
    # in the README -- would send the browser to a port where nothing listens.
    absolute_redirect off;

    # fullchain.pem is read from certs-effective, not from the host-mounted certs/
    # directory: the entrypoint writes a copy there with the leaf certificate first,
    # which nginx requires and the operator's file is not guaranteed to have. See
    # reorder_fullchain() in entrypoint.sh. The key is never reordered, so it is read
    # from the mount directly.
    ssl_certificate /etc/nginx/proxy/certs-effective/fullchain.pem;
    ssl_certificate_key /etc/nginx/proxy/certs/privkey.pem;

    # Security headers for all responses (including errors, hence "always"). HSTS tells
    # browsers to use HTTPS only; the others harden against MIME sniffing and clickjacking.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # The Django application serves its URLs under /${CRUDMAN_PATH} itself, so the
    # path is forwarded unchanged.
    location /${CRUDMAN_PATH}/ {
        # Record page visits (the map drops assets/non-GET); other requests are not logged
        # here. nginx's own access log on stdout still captures everything.
        access_log /var/log/app/visits.log visit_json if=$visit_log;
        # Dropzone file uploads pass through here; nginx's 1m default would reject them.
        client_max_body_size 512m;
        # All containers share the pod's network namespace, so the services are reachable
        # on localhost rather than by container name -- a pod has no internal DNS.
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana is configured to serve from /${GRAFANA_PATH} (see GF_SERVER_*), so the
    # path is forwarded unchanged.
    location /${GRAFANA_PATH}/ {
        access_log /var/log/app/visits.log visit_json if=$visit_log;
        # Grafana Live streams dashboard updates over a WebSocket. Upgrade and Connection
        # are hop-by-hop headers, which nginx drops, and the HTTP/1.0 it speaks upstream by
        # default cannot carry an upgrade at all: without these three lines Grafana answers
        # the handshake with 400. crudman serves no WebSocket and needs none of this.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Convenience redirect to the administration panel.
    location = / {
        return 302 /${CRUDMAN_PATH}/;
    }
}
