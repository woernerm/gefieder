# Development configuration: plain HTTP, no certificates required. The classification and
# the routing are shared with the production configuration; only the listener differs.
include /etc/nginx/proxy/maps.conf;

server {
    listen 80;
    # A company network's DNS may answer with an AAAA record. The entrypoint drops this
    # line on a kernel without IPv6, where nginx would refuse to start.
    listen [::]:80;

    include /etc/nginx/proxy/locations.conf;
}
