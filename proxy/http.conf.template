# Development configuration: plain HTTP, no certificates required.
#
# The request classification and the routing are shared with the production
# configuration; only the listener differs, and that is all this file states.
include /etc/nginx/proxy/maps.conf;

server {
    listen 80;
    # Also accept IPv6, which a company network's DNS may well answer with. The entrypoint
    # drops this line on a host whose kernel offers no IPv6, where nginx would refuse to
    # start over an address family it cannot bind.
    listen [::]:80;

    include /etc/nginx/proxy/locations.conf;
}
