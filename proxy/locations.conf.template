# The routing, included inside both configurations' server block. What differs between HTTP
# and HTTPS is the listener and the TLS setup, never where a path goes.

    # A path rather than a full URL: nginx builds an absolute one from the port it listens
    # on inside the pod, which is not the one the browser used.
    absolute_redirect off;

    # Room for the random name of Grafana's identity header, which the default of 64 holds
    # only as long as it hashes away from every other.
    proxy_headers_hash_bucket_size 128;

    # Django serves its URLs under /${CRUDMAN_PATH} itself, so the path is unchanged.
    location /${CRUDMAN_PATH}/ {
        # Page visits only, the map dropping assets and non-GET. nginx's own access log on
        # stdout still captures everything.
        access_log /var/log/app/visits.log visit_json if=$visit_log;
        # Dropzone uploads pass through here; nginx's 1m default would reject them.
        client_max_body_size 512m;
        # The containers share one network namespace, and a pod has no internal DNS.
        proxy_pass http://127.0.0.1:8000;
        # $http_host, not $host: it keeps the port the browser used, which the apps build
        # their absolute URLs from -- the single sign-on callback among them.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The burst is for a person mistyping; a program guessing passwords is refused. The
        # second address is allauth's. Nested, so the headers above apply unchanged.
        location ~ ^/${CRUDMAN_PATH}/(accounts/)?login/$ {
            limit_req zone=login burst=20 nodelay;
            limit_req_status 429;
            proxy_pass http://127.0.0.1:8000;
        }
    }

    # Grafana serves from /${GRAFANA_PATH} itself, so the path is unchanged.
    #
    # Grafana has no login of its own here: it trusts the X-WEBAUTH-* headers this location
    # sets from the admin panel's answer about the session cookie (auth_request below).
    # That is safe, as the one naming the visitor has a name only the two of them know.
    location /${GRAFANA_PATH}/ {
        access_log /var/log/app/visits.log visit_json if=$visit_log;
        # A request carrying Authorization is an API client's, whose credential Grafana
        # checks itself, and whose cookies are dropped (maps.conf.template). auth_request
        # cannot be made conditional, so the condition is in the subrequest's location.
        auth_request /_grafana_auth;
        auth_request_set $webauth_user  $upstream_http_x_webauth_user;
        auth_request_set $webauth_name  $upstream_http_x_webauth_name;
        auth_request_set $webauth_email $upstream_http_x_webauth_email;
        auth_request_set $webauth_role  $upstream_http_x_webauth_role;
        # Not a Grafana header: it feeds the map in maps.conf.template and through it the
        # substitution below.
        auth_request_set $preview_datasource $upstream_http_x_preview_datasource;
        # Nobody signed in: to the admin panel's login, and back here afterwards. That
        # login is where single sign-on happens when it is on.
        error_page 401 = @grafana_login;
        # Grafana Live streams over a WebSocket. Upgrade and Connection are hop-by-hop
        # headers nginx drops, and its upstream HTTP/1.0 cannot carry an upgrade at all.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Grafana, or crudman for a page of its own: see the map in maps.conf.template.
        proxy_pass http://127.0.0.1:$grafana_port;
        # $http_host, as above.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie $grafana_cookies;
        proxy_set_header ${GRAFANA_IDENTITY_HEADER} $webauth_user;
        proxy_set_header X-WEBAUTH-NAME  $webauth_name;
        proxy_set_header X-WEBAUTH-EMAIL $webauth_email;
        proxy_set_header X-WEBAUTH-ROLE  $webauth_role;

        # Which version a visitor sees: substituting the production data source's uid on
        # the way out puts a reviewer on the preview database in every dashboard. The
        # browser sends the uid back on /api/ds/query, so only answers are rewritten. The
        # upstream must not compress, as a compressed body cannot be substituted in.
        proxy_set_header Accept-Encoding "";
        gzip on;
        gzip_types application/json;
        gzip_proxied any;
        sub_filter_types application/json;
        sub_filter_once off;
        sub_filter '"postgresql-production"' '"$datasource_uid"';

        # A rotation Grafana refuses (an expired or orphaned token) would be a 401, on which
        # its frontend reloads forever. Sent through the login route instead, the one place
        # a token is issued: fetch follows the redirect and receives the new cookies.
        # Nested, so the identity check and the headers above apply unchanged.
        location = /${GRAFANA_PATH}/api/user/auth-tokens/rotate {
            proxy_intercept_errors on;
            error_page 401 = @grafana_reissue;
            proxy_pass http://127.0.0.1:3000;
        }
    }

    location @grafana_reissue {
        return 302 /${GRAFANA_PATH}/login;
    }

    # Grafana's static assets, which need no identity and are the bulk of a page load:
    # served without the subrequest above, which would otherwise run once per script,
    # style and font. Grafana answers them to anyone regardless.
    location /${GRAFANA_PATH}/public/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $http_host;
    }

    # The subrequest itself, unreachable as a URL. It carries the visitor's cookies, and no
    # X-Forwarded-For, whose absence tells the endpoint the call comes from inside the pod.
    location = /_grafana_auth {
        internal;
        # An API client answers for itself: 200 here means "no session to check", and the
        # X-WEBAUTH-* variables stay empty, so Grafana sees only the Authorization header.
        if ($http_authorization != "") {
            return 200;
        }
        proxy_pass http://127.0.0.1:8000/${CRUDMAN_PATH}/notebooks/grafana/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For "";
    }

    # Logged as a visit too, naming the page asked for. Back through Grafana's login route,
    # the one place it issues its session cookie, without which its frontend reloads
    # forever. The route lands on Grafana's home, so the page asked for is lost once.
    location @grafana_login {
        access_log /var/log/app/visits.log visit_json if=$visit_log;
        return 302 /${CRUDMAN_PATH}/login/?next=/${GRAFANA_PATH}/login;
    }

    # The Grafana MCP server, which serves its endpoint at /mcp and its health at
    # /healthz. It knows nothing of a subpath, so the prefix is stripped here -- the
    # trailing slash on proxy_pass is what does that.
    location /${MCP_PATH}/ {
        access_log /var/log/app/visits.log visit_json if=$visit_log;
        # streamable-http keeps a long-lived response open to stream events back, which
        # needs HTTP/1.1 and no buffering; the 60s default read timeout would cut an
        # idle session off mid-stream.
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_pass http://127.0.0.1:8001/;
        # Authorization passes untouched, so the server acts as the caller towards Grafana.
        # No auth_request, as an assistant has no browser session.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # JupyterHub serves from /${NOTEBOOK_PATH} itself, so the path is unchanged.
    location /${NOTEBOOK_PATH}/ {
        access_log /var/log/app/visits.log visit_json if=$visit_log;
        # A kernel talks to the browser over a WebSocket, and Upgrade and Connection are
        # hop-by-hop headers nginx drops; its upstream HTTP/1.0 cannot carry an upgrade
        # at all.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # A kernel that is idle between cells must not have its connection cut, and output
        # a cell streams back has to arrive as it is produced rather than in blocks.
        proxy_buffering off;
        proxy_read_timeout 24h;
        # A notebook is uploaded and downloaded whole, and a seed file may be large.
        client_max_body_size 512m;
        # The hub, or crudman for a page of its own: see the map in maps.conf.template.
        proxy_pass http://127.0.0.1:$notebook_port;
        # $http_host, as above.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The home page: the dashboards, in kiosk mode, inside the shell.
    location = / {
        return 302 /${GRAFANA_PATH}/?kiosk;
    }
