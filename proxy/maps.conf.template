# The request classification the visit log is built on, and the WebSocket handshake
# mapping. Both configurations need them identically, and a map may only appear at http
# level.

# --- dashboard/page visit logging -----------------------------------------------------
# A structured access log for usage statistics: which dashboard is visited, when, by which
# session. Limited to real page navigations, one dashboard view triggering dozens of API,
# asset and live-poll requests. The collector drains it into server_stats.dashboard_visit.

# The app a request is a page visit for, or "" to skip it. A dashboard is a page of the
# admin panel's, /${CRUDMAN_PATH}/dashboards/<name>/, and is named apart from the rest of
# it so the visits can be counted per dashboard; its panels arrive as requests of their
# own, marked as htmx's (below). Assets are never a visit.
map $uri $visit_app {
    default                              "";
    ~^/${CRUDMAN_PATH}/static/           "";   # assets, not a page view
    ~^/${CRUDMAN_PATH}/dashboards/       dashboards;
    ~^/${CRUDMAN_PATH}/                  crudman;
}

# A POST is a form submit or a login, not a visit, and a request htmx makes is part of a
# page already counted: a panel drawing itself, the bar fetching its stages.
map "$request_method:$http_hx_request" $visit_is_get {
    default  0;
    "GET:"   1;
}

# The final gate: the app name when the request is a GET that matched one, and non-empty
# is what "if=$visit_log" below logs on.
map "$visit_is_get:$visit_app" $visit_log {
    default        "";
    ~^1:(.+)$      $1;
}

# One JSON object per visit; escape=json keeps a user-controlled field from breaking it.
# The session cookie is logged raw -- the log lives on the proxy's own volume -- and the
# collector hashes it, so the raw value never reaches the database.
log_format visit_json escape=json
    '{"ts":"$time_iso8601","app":"$visit_app","path":"$uri",'
    '"status":$status,"ip":"$remote_addr","xff":"$http_x_forwarded_for",'
    '"ua":"$http_user_agent",'
    '"crudman_session":"$cookie_sessionid"}';

# --- the shell around every page --------------------------------------------------------
# A page a browser puts in its address bar goes to crudman whichever app the path belongs
# to, and crudman answers with the shell: the bar, and a frame asking for the same path
# again (crudman/app/shell/middleware.py). The frame's request says "iframe" here and
# reaches the app. Only a GET can be a page; the header is missing from older browsers
# and from scripts, which then get the app as before.
map "$request_method:$http_sec_fetch_dest" $notebook_port {
    default        8888;
    "GET:document" 8000;
}

# --- WebSocket handshakes ---------------------------------------------------------------
# The Connection header sent upstream: "upgrade" for a handshake, "close" otherwise.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
