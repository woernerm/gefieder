# Build-time configuration. These values are baked into the images and the
# rendered quadlet artifact at build time.
APP_NAME=gefieder
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@nowhere.com
# Fallback for install.sh when its password prompt is answered empty; dev.sh always uses
# it. Not "admin", which would make Grafana demand a change on first login.
SUPERUSER_DEFAULT_PASSWORD=admin123
CRUDMAN_PATH=crudman
GRAFANA_PATH=grafana

# The database every service connects to, holding the crudman schema, the medallion layers,
# the server statistics and SQLMesh's state. Named here because a shared cluster may already
# hold a database called "postgres".
#
# Created when the data volume is first initialized, so a change needs a rebuild and a fresh
# volume. Letters, digits and underscores only.
PG_DATABASE=postgres

# The PostgreSQL login role each service connects as. Named here because they share one
# namespace with the tenant roles and the per-administrator accounts, so a database already
# holding one of these names is a rename here rather than a patch to the init scripts. Only
# the role names: the containers, schemas and podman secrets keep the component name.
#
# Baked into the database image by postgresql/render.sh and created by the init scripts,
# which run once, so a change needs a rebuild and a fresh data volume.
CRUDMAN_DB_USER=crudman
SQLMESH_DB_USER=sqlmesh
GRAFANA_DB_USER=grafana

# The podman secrets holding the credentials. They share a namespace with every other
# secret on the machine, so a host already holding one of these names renames it here. They
# keep the component's name rather than the database role's.
#
# A change needs a rebuild, the names being rendered into the quadlets. It does not rename
# the secrets already on the machine: create the new ones before restarting, or the
# containers naming them refuse to start.
SECRET_SUPERUSER_PASSWORD=superuser_password
SECRET_CRUDMAN_PASSWORD=crudman_password
SECRET_SQLMESH_PASSWORD=sqlmesh_password
SECRET_GRAFANA_PASSWORD=grafana_password
SECRET_DJANGO_KEY=django_secret_key
SECRET_OIDC_CLIENT=oidc_client_secret

# The prefix on the login role each administrator is provisioned (<prefix><name>).
# Readability, not a boundary: gf_0003's functions recognise a personal role by the marker
# it holds (is_db_user), never by its name, so this may be empty.
#
# Shorter is better: PostgreSQL caps an identifier at 63 characters.
DB_USER_PREFIX=

# The prefix on the rank names: the Django groups carrying an identity-provider rank's
# permissions, and the database group roles gf_0008 creates. The provider says only
# "Editor"; <prefix>editor holds the rights in both systems. Change it where these names
# would collide with groups your admin already uses; the ranks themselves are fixed, what
# each may do being written into GROUP_ACTIONS in crudman/app/sso/roles.py.
#
# Not empty: the ranks are cluster role names, and an unprefixed "admin" is the
# SUPERUSER_NAME above. gf_0008 refuses to start on such a collision.
ROLE_PREFIX=gf_

# The medallion schemas. Bronze is one schema per tenant (<prefix><tenant>), hence a
# prefix; the other two are single schemas. All are used unquoted as SQL identifiers, so
# keep them lowercase, digits and underscores. The silver staging layer is absent because
# nothing outside the SQLMesh models names it.
#
# render.sh bakes them into the database image, and crudman reads the bronze prefix back to
# discover tenants. The example models spell the names out -- SQLMesh never sees this file
# -- so a rename here means one there too; tests/test_medallion_schemas.py catches it.
BRONZE_SCHEMA_PREFIX=bronze_
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold

# The host directory holding the proxy's TLS certificate (fullchain.pem and privkey.pem).
# A directory rather than a volume, so a certificate is renewed with an ordinary copy.
# In systemd syntax, only systemd resolving it: "%h" is the home of the user running the
# containers, and an absolute path such as /etc/pki/${APP_NAME} works too. Baked into the
# proxy quadlet, so a change needs a rebuild.
CERTIFICATE_PATH=%h/.config/${APP_NAME}/certs

# The name of the schema that holds the server resource-usage and query statistics.
SERVER_STATS_SCHEMA=server_stats

# How often, in seconds, the collector takes a sample. Build-time because systemd reads a
# cadence only from the unit file. 60s is plenty for sizing.
SERVER_STATS_INTERVAL=60

# The DuckDB community extensions to ship, downloaded at build time into both images that
# run DuckDB, so the target machine needs no internet access. Licenses and quality vary, so
# trim to what you need.
#
# One entry per line; the trailing backslashes are shell line continuations, so a continued
# line has to start in the first column.
#   duckpgq     graph queries over traceability/requirement links
#   dash        serve query results as lightweight dashboards
#   flock       call LLMs from SQL (e.g. classify free-text fields)
#   minijinja   Jinja templating to parameterize report queries
#   stochastic  sampling and distributions for statistical metrics
#   yaml        read YAML exports from engineering tools
#   zipfs       read files inside zipped tool exports
DUCKDB_EXTENSIONS=\
duckpgq,\
dash,\
flock,\
minijinja,\
stochastic,\
yaml,\
zipfs

# The Grafana panel plugins to ship, by plugin id, written and baked in like the DuckDB
# extensions above. None ships with Grafana itself, all are signed, and licenses and
# quality vary, so trim to what your dashboards use.
#   volkovlabs-echarts-panel        Business Charts: the whole Apache ECharts library
#   innius-video-panel              Video: play a video or camera stream on a dashboard
#   marcusolsson-calendar-panel     Business Calendar: events on a month/day grid
#   volkovlabs-links-panel          Business Links: navigation between dashboards
#   volkovlabs-table-panel          Business Table: grouping, editing and nested tables
#   marcusolsson-dynamictext-panel  Business Text: HTML/Markdown templated from the data
#   volkovlabs-variable-panel       Business Variable: a richer dashboard variable picker
#   neildengg-grafmaid-panel        Grafmaid: Mermaid diagrams drawn from query results
#   isaozler-paretochart-panel      Pareto Chart: ranked bars with a cumulative line
#   nline-plotlyjs-panel            Plotly: charts written as plotly.js JSON
GRAFANA_PLUGINS=\
volkovlabs-echarts-panel,\
innius-video-panel,\
marcusolsson-calendar-panel,\
volkovlabs-links-panel,\
volkovlabs-table-panel,\
marcusolsson-dynamictext-panel,\
volkovlabs-variable-panel,\
neildengg-grafmaid-panel,\
isaozler-paretochart-panel,\
nline-plotlyjs-panel

# Your repository's full URL; the installer downloads from <REPO>/releases/latest.
REPO=https://github.com/your-org/${APP_NAME}

# Docker image repository URL without https://, http://, or a trailing slash. 
REGISTRY=ghcr.io/your-org/${APP_NAME}
IMAGE_TAG=latest

# Proxy settings to use during image builds. Leave empty if you do not build your images
# from behind a proxy. 
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Extra Python package index, e.g. artifactory. Leave empty to use PyPI directly.
PYTHON_INDEX=

# Where the build pulls its base images from; point these at a pull-through mirror, both
# at the same value if it serves both. Host and path only, and neither may be empty.
DOCKER_IO_MIRROR=docker.io
GHCR_IO_MIRROR=ghcr.io

# Custom temporary directory, empty for the system default. Each script creates and
# removes its own subdirectory below it.
TEMPDIR=

# As TEMPDIR, for the test suite, which may need more scratch space than one filesystem
# has.
TEMPDIR_TESTS=
