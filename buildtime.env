# Build-time configuration. These values are baked into the images and the
# rendered quadlet artifact at build time.
APP_NAME=gefieder
# The person who administers the system: a Django account and a Grafana login, one
# identity in both. Not a PostgreSQL role of its own -- they reach the database through
# the ordinary login role dbusers provisions for them, like everybody else.
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@nowhere.com
# Fallback for install.sh when its password prompt is answered empty; dev.sh always uses
# it. Not "admin", which would make Grafana demand a change on first login.
SUPERUSER_DEFAULT_PASSWORD=admin123
CRUDMAN_PATH=crudman
GRAFANA_PATH=grafana
# Under a shared /ai/ prefix, so a second MCP server can join it there. The only path that
# may carry a slash; the proxy matches the longest prefix, so no ordering rule is needed.
MCP_PATH=ai/grafana_mcp

# Where JupyterHub is served, for developing the analytics models in a notebook. A single
# segment. Not JUPYTER_PATH, which Jupyter itself reads as its data search path.
NOTEBOOK_PATH=jupyter

# The database every service connects to, as a shared cluster may already hold one named
# "postgres". Created with the data volume, so a change needs a rebuild and a fresh volume.
# Letters, digits and underscores only.
PG_DATABASE=postgres

# The PostgreSQL login role each service connects as, renamable where a name is taken in
# the cluster. Containers, schemas and secrets keep the component name. Created by the init
# scripts, so a change needs a rebuild and a fresh data volume.
CRUDMAN_DB_USER=crudman
SQLMESH_DB_USER=sqlmesh
GRAFANA_DB_USER=grafana

# The cluster superuser, which owns the database and runs the init scripts. Must not equal
# a person's sign-in name, whose database role it would then be. Its password is generated
# at install and never shown.
PG_SUPERUSER_ROLE=postgres

# The podman secrets holding the credentials, renamable where a name is taken on the host.
# A change needs a rebuild and does not rename existing secrets: create the new ones before
# restarting, or the containers refuse to start.
SECRET_SUPERUSER_PASSWORD=superuser_password
SECRET_PG_SUPERUSER_PASSWORD=postgres_password
SECRET_CRUDMAN_PASSWORD=crudman_password
SECRET_SQLMESH_PASSWORD=sqlmesh_password
SECRET_GRAFANA_PASSWORD=grafana_password
SECRET_DJANGO_KEY=django_secret_key
SECRET_OIDC_CLIENT=oidc_client_secret
SECRET_JUPYTER=jupyter_secret
SECRET_GRAFANA_IDENTITY=grafana_identity

# The prefix on each person's login role (<prefix><name>). May be empty, as personal roles
# are recognised by a marker, not by name. Keep it short: identifiers are capped at 63.
DB_USER_PREFIX=

# The prefix on the rank names: the Django groups and database group roles carrying a
# provider rank such as "Editor" (<prefix>editor). Not empty, as an unprefixed "admin"
# would be the role of a person named admin; gf_0008 refuses such a collision.
ROLE_PREFIX=gf_

# The medallion schemas; bronze is one schema per project (<prefix><project>). Lowercase,
# digits and underscores only. The example models spell the names out, so a rename here
# means one there too (tests/test_medallion_schemas.py checks).
BRONZE_SCHEMA_PREFIX=bronze_
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold

# The host directory holding the proxy's TLS certificate (fullchain.pem and privkey.pem),
# so renewing is an ordinary copy. Systemd syntax: "%h" is the home of the user running the
# containers; an absolute path works too. A change needs a rebuild.
CERTIFICATE_PATH=%h/.config/${APP_NAME}/certs

# The name of the schema that holds the server resource-usage and query statistics.
SERVER_STATS_SCHEMA=server_stats

# How often, in seconds, the collector takes a sample. Build-time because systemd reads a
# cadence only from the unit file. 60s is plenty for sizing.
SERVER_STATS_INTERVAL=60

# The DuckDB community extensions to ship, downloaded at build time, so the target needs no
# internet access. Licenses and quality vary, so trim to what you need. One entry per line,
# starting in the first column (shell line continuations).
#   flock       call LLMs from SQL (e.g. classify free-text fields)
#   yaml        read YAML exports from engineering tools
#
# Not in the community repository for DuckDB 2.0, so left out:
#   duckpgq     graph queries over traceability/requirement links (not yet built)
#   dash        serve query results as lightweight dashboards (not yet built)
#   zipfs       read files inside zipped tool exports (not yet built)
#   minijinja   Jinja templating to parameterize report queries (moved to Query.Farm)
#   stochastic  sampling and distributions for statistical metrics (moved to Query.Farm)
DUCKDB_EXTENSIONS=\
flock,\
yaml

# Optional JupyterLab extensions to ship, by pip package name, downloaded at build time.
# What the workflow depends on is in jupyter/requirements.txt. Prebuilt extensions only (no
# node build). Written like the lists above.
#   jupyterlab-lsp        completion and go-to-definition; inert until a language server is
#                         registered in jupyter/jupyter_server_config.py (sqlmesh_lsp is installed)
#   jupyterlab-execute-time   how long a cell took, under each cell
#   jupyterlab_code_formatter formats a model definition on save
#   quak                      column explorer: per-column distributions over the result
#   jupyterlab-materialdarker the dark theme Lab starts in; overrides.json selects it
JUPYTER_EXTENSIONS=\
jupyterlab-execute-time,\
quak,\
jupyterlab-materialdarker,

# The Grafana panel plugins to ship, by plugin id, written and baked in like the DuckDB
# extensions above. None ships with Grafana itself, all are signed, and licenses and
# quality vary, so trim to what your dashboards use.
#   volkovlabs-echarts-panel        Business Charts: the whole Apache ECharts library
#   innius-video-panel              Video: play a video or camera stream on a dashboard
#   marcusolsson-calendar-panel     Business Calendar: events on a month/day grid
#   volkovlabs-links-panel          Business Links: navigation between dashboards
#   volkovlabs-table-panel          Business Table: grouping, editing and nested tables
#   marcusolsson-dynamictext-panel  Business Text: HTML/Markdown templated from the data
#   volkovlabs-variable-panel       Business Variable: a richer dashboard variable picker
#   neildengg-grafmaid-panel        Grafmaid: Mermaid diagrams drawn from query results
#   isaozler-paretochart-panel      Pareto Chart: ranked bars with a cumulative line
#   nline-plotlyjs-panel            Plotly: charts written as plotly.js JSON
GRAFANA_PLUGINS=\
volkovlabs-echarts-panel,\
innius-video-panel,\
marcusolsson-calendar-panel,\
volkovlabs-links-panel,\
volkovlabs-table-panel,\
marcusolsson-dynamictext-panel,\
volkovlabs-variable-panel,\
neildengg-grafmaid-panel,\
isaozler-paretochart-panel,\
nline-plotlyjs-panel

# The tool categories the Grafana MCP server offers: the defaults plus admin, runpanelquery
# and examples. Categories for absent datasources and Grafana Cloud would only fill the
# assistant's context. Grafana decides what a caller may do, by the credential presented
# (GRAFANA_FORWARD_HEADERS in quadlets/grafana_mcp.container). Written like the lists above.
GRAFANA_MCP_TOOLS=\
search,datasource,incident,prometheus,loki,alerting,dashboard,folder,oncall,asserts,\
sift,pyroscope,navigation,proxied,annotations,rendering,snapshot,plugin,api,config,\
provisioning,docs,user,admin,runpanelquery,examples

# Your repository's full URL; the installer downloads from <REPO>/releases/latest.
REPO=https://github.com/your-org/${APP_NAME}

# The git repository holding the analytics models; shipping a model is a commit to it.
# The default is a bare repository on the models volume, seeded with this release's
# project, so no git host is needed. Anything "git clone" accepts works, e.g.
# https://github.com/your-org/your-models.git; crudman then polls its "main" branch.
# Empty is refused, as the volume would hold the only copy of the history.
REPO_MODELS=/var/lib/app/models/origin.git

# Image repository URL without https://, http://, or a trailing slash.
REGISTRY=ghcr.io/your-org/${APP_NAME}
IMAGE_TAG=latest

# Proxy settings for image builds. Leave empty if you do not build behind a proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Extra Python package index, e.g. artifactory. Leave empty to use PyPI directly.
PYTHON_INDEX=

# Where the build pulls its base images from; point these at a pull-through mirror, both
# at the same value if it serves both. Host and path only, and neither may be empty.
DOCKER_IO_MIRROR=docker.io
GHCR_IO_MIRROR=ghcr.io

# Custom temporary directory, empty for the system default. Each script creates and
# removes its own subdirectory below it.
TEMPDIR=

# As TEMPDIR, for the test suite, which may need more scratch space than one filesystem
# has.
TEMPDIR_TESTS=
