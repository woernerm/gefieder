# Build-time configuration. These values are baked into the images and the
# rendered quadlet artifact at build time.
APP_NAME=gefieder
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@nowhere.com
# Fallback for install.sh when its password prompt is answered empty; dev.sh always uses
# it. Not "admin", which would make Grafana demand a change on first login. The real
# password is a podman secret, so changing it in Grafana has no effect.
SUPERUSER_DEFAULT_PASSWORD=admin123
CRUDMAN_PATH=crudman
GRAFANA_PATH=grafana

# The database every service connects to. "postgres" is the one the PostgreSQL image
# creates by default, and the whole system lives in it: the crudman schema, the medallion
# layers, the server statistics and SQLMesh's state. Named here rather than repeated in the
# five quadlets that pass it, the init script that grants CREATE on it, the Grafana data
# source and the cheat sheet, because a cluster the deployment shares may already hold a
# database of that name.
#
# The PostgreSQL entrypoint creates it when the data volume is first initialized, so a
# change needs a rebuild and a fresh data volume, exactly as the role names below do.
# Letters, digits and underscores only.
PG_DATABASE=postgres

# The PostgreSQL login role each service connects as. Named here rather than spelled out in
# the two dozen places that create, grant on or connect as them, because they share one
# namespace with the tenant roles and the per-administrator accounts: a deployment whose
# database already holds a role of one of these names renames it here instead of patching
# the init scripts. Only the role names -- the containers, the schemas and the podman
# secrets holding these passwords keep the component name, so SECRET_CRUDMAN_PASSWORD
# stays "crudman_password" whatever CRUDMAN_DB_USER says.
#
# postgresql/render.sh bakes them into the database image, so a change needs a rebuild --
# and, because the roles are created by the init scripts, which run once, a fresh data
# volume as well. Letters, digits and underscores only.
CRUDMAN_DB_USER=crudman
SQLMESH_DB_USER=sqlmesh
GRAFANA_DB_USER=grafana

# The names of the podman secrets holding the credentials, named here rather than in the
# two dozen places that create, mount, read or delete them. They share a namespace with
# every other podman secret on the machine, so a host already holding one of these names
# renames it here instead.
#
# They keep the component's name rather than the database role's: a secret belongs to the
# service that owns the password, so SECRET_CRUDMAN_PASSWORD stays put when
# CRUDMAN_DB_USER is renamed to dodge a collision.
#
# A change needs a rebuild, the names being rendered into the quadlets and baked into the
# images. It does not rename the secrets already on the machine: create the new ones
# before restarting, or the containers naming them refuse to start.
SECRET_SUPERUSER_PASSWORD=superuser_password
SECRET_CRUDMAN_PASSWORD=crudman_password
SECRET_SQLMESH_PASSWORD=sqlmesh_password
SECRET_GRAFANA_PASSWORD=grafana_password
SECRET_DJANGO_KEY=django_secret_key
SECRET_OIDC_CLIENT=oidc_client_secret

# The prefix on the login role each administrator is provisioned (<prefix><name>). It is
# readability, not a boundary: it tells the personal roles from the service and tenant
# roles at a glance in \du, while the functions in gf_0003 recognise one by the marker role
# it holds (is_db_user) and never by its name. So it may be empty, and a collision with a
# tenant of the same name is refused rather than silently taken over.
#
# "gf_" is short for the default APP_NAME; a whitelabel deployment sets its own, and
# shorter is better because PostgreSQL caps an identifier at 63 characters.
DB_USER_PREFIX=

# The prefix on the rank names: both the Django groups that carry the permissions of an
# identity-provider rank and the database group roles gf_0008 creates. The provider only
# ever says "Editor"; the group <prefix>editor is what actually holds the rights, and the
# database role of that same name carries them in PostgreSQL -- so the three ranks are
# named once here and spelled the same way in all three systems. Change it if these names
# would collide with groups your admin already uses; the ranks themselves are not
# configurable, because what each may do is written into GROUP_ACTIONS in
# crudman/app/sso/roles.py.
#
# It must not be empty: the ranks are cluster role names now, and an unprefixed "admin"
# is the SUPERUSER_NAME above. gf_0008 refuses to start on any such collision.
ROLE_PREFIX=gf_

# The medallion schemas. Bronze is one schema per tenant, created as <prefix><tenant>, so
# it is a prefix rather than a name; the other two are single schemas. All are used
# unquoted as SQL identifiers, so keep them lowercase, digits and underscores.
#
# The silver staging layer is deliberately absent: nothing outside the SQLMesh models names
# it, so it is derived in tests/conftest.py where its only readers are.
#
# render.sh bakes them into the database image, and crudman reads the bronze prefix back to
# discover tenants. The example models under sqlmesh/models/ still spell the names out — a
# model name is parsed by SQLMesh, which never sees this file — so renaming a layer here
# means renaming it there too. tests/test_medallion_schemas.py fails when they disagree.
BRONZE_SCHEMA_PREFIX=bronze_
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold

# The host directory holding the proxy's TLS certificate (fullchain.pem and privkey.pem).
# A real directory rather than a volume, so certificates can be renewed with an ordinary
# copy. Written in systemd syntax, because only systemd ever resolves it: "%h" is the
# home directory of the user running the containers. An absolute path such as
# /etc/pki/${APP_NAME} works too, e.g. to point at a directory your PKI already fills.
# Baked into the proxy quadlet, so changing it needs a rebuild.
CERTIFICATE_PATH=%h/.config/${APP_NAME}/certs

# The name of the schema that holds the server resource-usage and query statistics.
SERVER_STATS_SCHEMA=server_stats

# How often, in seconds, the server-statistics collector takes a sample. Build-time rather
# than runtime because it is baked into the collector's systemd timer: systemd reads a
# cadence only from the unit file, never from an environment file. 60s is plenty for sizing.
SERVER_STATS_INTERVAL=60

# The DuckDB community extensions to ship. Downloaded at build time into both images that
# run DuckDB — PostgreSQL through pg_duckdb, SQLMesh for its duckdb gateway — so the target
# machine needs no internet access. Licenses and quality vary, so trim to what you need.
#
# One entry per line, so adding or removing one is a one-line change. The trailing
# backslashes are line continuations: the scripts source this file as shell, which joins
# them into one comma-separated value. A continued line has to start in the first column.
#   duckpgq     graph queries over traceability/requirement links
#   dash        serve query results as lightweight dashboards
#   flock       call LLMs from SQL (e.g. classify free-text fields)
#   minijinja   Jinja templating to parameterize report queries
#   stochastic  sampling and distributions for statistical metrics
#   yaml        read YAML exports from engineering tools
#   zipfs       read files inside zipped tool exports
DUCKDB_EXTENSIONS=\
duckpgq,\
dash,\
flock,\
minijinja,\
stochastic,\
yaml,\
zipfs

# The Grafana panel plugins to ship, by plugin id and written like the DuckDB extensions
# above, and baked in for the same reason. None ships with Grafana itself, all are signed,
# and licenses and quality vary, so trim to what your dashboards use. Empty ships none.
#   volkovlabs-echarts-panel        Business Charts: the whole Apache ECharts library
#   innius-video-panel              Video: play a video or camera stream on a dashboard
#   marcusolsson-calendar-panel     Business Calendar: events on a month/day grid
#   volkovlabs-links-panel          Business Links: navigation between dashboards
#   volkovlabs-table-panel          Business Table: grouping, editing and nested tables
#   marcusolsson-dynamictext-panel  Business Text: HTML/Markdown templated from the data
#   volkovlabs-variable-panel       Business Variable: a richer dashboard variable picker
#   neildengg-grafmaid-panel        Grafmaid: Mermaid diagrams drawn from query results
#   isaozler-paretochart-panel      Pareto Chart: ranked bars with a cumulative line
#   nline-plotlyjs-panel            Plotly: charts written as plotly.js JSON
GRAFANA_PLUGINS=\
volkovlabs-echarts-panel,\
innius-video-panel,\
marcusolsson-calendar-panel,\
volkovlabs-links-panel,\
volkovlabs-table-panel,\
marcusolsson-dynamictext-panel,\
volkovlabs-variable-panel,\
neildengg-grafmaid-panel,\
isaozler-paretochart-panel,\
nline-plotlyjs-panel

# Your repository's full URL. The installer derives the download URL from it
# (<REPO>/releases/latest/download).
REPO=https://github.com/your-org/${APP_NAME}

# Docker image repository URL without https://, http://, or a trailing slash. 
REGISTRY=ghcr.io/your-org/${APP_NAME}
IMAGE_TAG=latest

# Proxy settings to use during image builds. Leave empty if you do not build your images
# from behind a proxy. 
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Extra Python package index, e.g. artifactory. Leave empty to use PyPI directly.
PYTHON_INDEX=

# Where the build pulls its base images from. Point these at a pull-through mirror
# (e.g. artifactory). If your mirror serves both from one repository, set both to that 
# same value. Host and path only: no https://, no trailing slash. Neither may be empty.
DOCKER_IO_MIRROR=docker.io
GHCR_IO_MIRROR=ghcr.io

# Custom temporary directory. Empty = the system default. Each script creates and removes
# its own subdirectory below it, leaving anything else there alone.
TEMPDIR=

# Same as TEMPDIR, but for the test suite, which needs far more scratch space than an
# installation and may therefore have to live on a different filesystem.
TEMPDIR_TESTS=
