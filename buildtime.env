# Build-time configuration. These values are baked into the images and the
# rendered quadlet artifact at build time.
APP_NAME=gefieder
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@nowhere.com
# Default superuser password. dev.sh always uses it; install.sh prompts for a password and
# falls back to this one when the prompt is answered with an empty line. It is deliberately
# not "admin", otherwise Grafana shows a "change the default password" prompt on first
# login. However, the superuser password is controlled by setting a podman secret.
# Therefore, the password should not be changed in Grafana.
SUPERUSER_DEFAULT_PASSWORD=admin123
# The host name the system is reached under, used verbatim for the browser address, the
# TLS certificate and the dropzone addresses. Give it fully qualified, e.g.
# "abc123.mycompany.com": on most company networks a browser hands a bare machine name to
# the web proxy instead of resolving it. "localhost" for a local development system.
SERVER_NAME=localhost
CRUDMAN_PATH=crudman
GRAFANA_PATH=grafana

# The name of the schema that holds the server resource-usage and query statistics.
SERVER_STATS_SCHEMA=server_stats

# The DuckDB community extensions to ship, comma-separated. They are downloaded into the
# PostgreSQL image at build time, so the target machine needs no internet access to use
# them. Licenses and quality vary, so trim this to what your queries actually need.
# Commas rather than spaces because this file is read two ways: the scripts source it as
# shell, where an unquoted space would split the value, and the CI workflow copies the
# lines verbatim into $GITHUB_ENV, where quotes would be kept as part of the value.
#   duckpgq     graph queries over traceability/requirement links
#   dash        serve query results as lightweight dashboards
#   flock       call LLMs from SQL (e.g. classify free-text fields)
#   minijinja   Jinja templating to parameterize report queries
#   stochastic  sampling and distributions for statistical metrics
#   yaml        read YAML exports from engineering tools
#   zipfs       read files inside zipped tool exports
DUCKDB_EXTENSIONS=duckpgq,dash,flock,minijinja,stochastic,yaml,zipfs

# The full URL of the GitHub repository from which the installer derives the 
# download URL (e.g. <REPO>/releases/latest/download). Set it to your own repository 
# URL. 
REPO=https://github.com/your-org/gefieder

# Docker image repository URL without https://, http://, or a trailing slash. 
REGISTRY=ghcr.io/your-org/gefieder
IMAGE_TAG=latest

# Proxy settings to use during image builds. Leave empty if you do not build your images
# from behind a proxy. 
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Extra Python package index, e.g. artifactory. Leave empty to use PyPI directly.
PYTHON_INDEX=

# Custom temporary directory. Leave empty to use the system default. Each script still
# creates its own subdirectory below it and removes that subdirectory when it exits, so
# the directory itself and anything else in it are left alone.
TEMPDIR=

# Same as TEMPDIR, but for the integration test suite. It is kept separate because the
# test run needs far more scratch space than an installation and may therefore have to
# live on a different filesystem.
TEMPDIR_TESTS=

# Development vs. production mode. DEBUG=true serves plain HTTP without certificates and
# shows Django debug pages; the default (false) serves HTTPS only and needs a
# certificate in ~/.config/<APP_NAME>/certs/. 
DEBUG=false
