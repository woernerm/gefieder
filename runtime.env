# Runtime configuration, read at start, so a change takes effect on the next restart
# without a rebuild. A reinstall keeps the file already on the host.
#
# A value may not contain spaces: the scripts source this as shell while podman reads it as
# an env file and keeps quotes as part of the value.

# The host name the system is reached under, used verbatim for the browser address, the
# TLS certificate and the dropzone addresses. Give it fully qualified: on most company
# networks a browser hands a bare machine name to the web proxy instead of resolving it.
SERVER_NAME=localhost

# true serves plain HTTP and Django's debug pages; false serves HTTPS only and needs a
# certificate in ~/.config/<APP_NAME>/certs/. Keep it false on a networked server.
DEBUG=false

# What a browser, a reporting tool or an uploader connects to. Inside the pod the services
# keep 80, 443 and 5432 whatever these say.
#
# Rootless podman cannot bind 80 and 443 on a stock kernel; the installer prints the sysctl
# that lifts the reservation, and moving them above 1024 here needs no root at all.
HTTP_PORT=80
HTTPS_PORT=443
PG_PORT=5432

# The two dropzone endpoints, whose published port is also the one they listen on inside
# the pod. Their healthchecks and the address the admin panel shows uploaders follow from
# here, so changing one needs no second edit.
SFTP_PORT=2222
FLIGHT_PORT=8815

# Single sign-on via OpenID Connect, shared by the admin panel and Grafana, off by default
# so a fresh installation keeps the local logins. While on, an unauthenticated browser goes
# straight to the provider. The README explains the provider-side setup.
OIDC_ENABLED=false

# The issuer URL, whose /.well-known/openid-configuration describes the rest. The admin
# panel discovers its endpoints from it.
#   Entra ID:   https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:   https://<host>/realms/<realm>
OIDC_ISSUER=

# The same endpoints spelled out, because Grafana has no discovery. They appear in the
# openid-configuration document as authorization_endpoint, token_endpoint and
# userinfo_endpoint. For Entra ID:
#   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
#   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
#   https://graph.microsoft.com/oidc/userinfo
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# Where signing out sends the browser, the end_session_endpoint of the same document. Left
# empty, signing out ends only the session here and the next page view is signed straight
# back in. Give it without a query string: an "&" in a value truncates it silently.
#   Entra ID:   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/logout
OIDC_LOGOUT_URL=

# The client (application) ID. One registration serves both services, told apart by their
# redirect URLs. The client secret is a podman secret; the cheat sheet sets it.
OIDC_CLIENT_ID=

# Normally empty: what to ask the provider for is worked out from the issuer above -- the
# three standard scopes, plus for Entra ID the permission Microsoft wants before parting
# with profile pictures. Fill this in only to overrule that, e.g. for a tenant that will
# not grant the extra permission:
#   openid profile email
OIDC_SCOPES=
