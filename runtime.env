# Runtime configuration, read at start, so a change takes effect on the next restart
# without a rebuild. A reinstall keeps the file already on the host.
#
# A value may not contain spaces: the scripts source this as shell while podman reads it as
# an env file and keeps quotes as part of the value.

# The host name the system is reached under, used verbatim for the browser address, the
# TLS certificate and the dropzone addresses. Give it fully qualified: on most company
# networks a browser hands a bare machine name to the web proxy instead of resolving it.
SERVER_NAME=localhost

# true serves plain HTTP and Django's debug pages; false serves HTTPS only and needs a
# certificate in ~/.config/<APP_NAME>/certs/. Keep it false on a networked server.
DEBUG=false

# What a browser, a reporting tool or an uploader connects to. Inside the pod the services
# keep 80, 443 and 5432 whatever these say.
#
# Rootless podman cannot bind 80 and 443 on a stock kernel; the installer prints the sysctl
# that lifts the reservation, and moving them above 1024 here needs no root at all.
HTTP_PORT=80
HTTPS_PORT=443
PG_PORT=5432

# The two dropzone endpoints, published and listened on inside the pod under the same port.
# Healthchecks and the addresses shown to uploaders follow from here.
SFTP_PORT=2222
FLIGHT_PORT=8815

# The colour mode a browser starts in, dark or light, shared by Grafana, the admin panel and
# the notebooks. A person's own choice, made in any of them, is kept by their browser.
DEFAULT_THEME=dark

# How often, in seconds, crudman fetches the models repository and deploys what "main"
# points at, trading deployment latency against load on the git host. 0 switches the poll
# off, leaving the versions page the only way to deploy.
MODELS_POLL_INTERVAL=20

# Single sign-on via OpenID Connect, shared by all apps, off by default so a fresh
# installation keeps the local logins. While on, an unauthenticated browser goes
# straight to the provider. The README explains the provider-side setup.
OIDC_ENABLED=false

# The issuer URL, whose /.well-known/openid-configuration describes the endpoints.
#   Entra ID:   https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:   https://<host>/realms/<realm>
OIDC_ISSUER=

# Where signing out sends the browser, the issuer's end_session_endpoint. Left
# empty, signing out ends only the session here and the next page view is signed straight
# back in. Give it without a query string: an "&" in a value truncates it silently.
#   Entra ID:   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/logout
OIDC_LOGOUT_URL=

# The client (application) ID. One registration for the whole system: only the admin panel
# talks to the provider, Grafana and the notebooks taking the signed-in person from it.
# The client secret is a podman secret; the cheat sheet sets it.
OIDC_CLIENT_ID=

# Normally empty: the scopes follow from the issuer, adding Entra ID's permission for
# profile pictures. Fill in only to overrule that, e.g. for a tenant refusing it:
#   openid profile email
OIDC_SCOPES=
