# Runtime configuration. These values are read when the system starts, so a change takes
# effect on the next restart without a rebuild. A reinstall keeps the file already on the
# host, so local edits survive an upgrade.
#
# A value may not contain spaces. The scripts source this file as shell, while podman reads
# it as an env file and keeps quotes as part of the value, so there is no spelling of a
# spaced value that works for both.

# The host name the system is reached under, used verbatim for the browser address, the
# TLS certificate and the dropzone addresses. Give it fully qualified, e.g.
# "abc123.mycompany.com": on most company networks a browser hands a bare machine name to
# the web proxy instead of resolving it. "localhost" for a local development system.
SERVER_NAME=localhost

# Development vs. production mode. true serves plain HTTP and Django's debug pages; false
# serves HTTPS only and needs a certificate in ~/.config/<APP_NAME>/certs/. Keep it false
# on a networked server: the debug pages show tracebacks and settings to anyone.
DEBUG=false

# Single sign-on via OpenID Connect, shared by the admin panel and Grafana. Off by default,
# so a fresh installation keeps the local logins. While on, an unauthenticated browser goes
# straight to the provider and someone already signed in there never sees a login page.
# Plain OpenID Connect rather than one vendor's API, so any provider works. The README
# explains the provider-side setup.
OIDC_ENABLED=false

# The issuer URL, whose /.well-known/openid-configuration describes the rest. The admin
# panel discovers its endpoints from it.
#   Entra ID:   https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:   https://<host>/realms/<realm>
OIDC_ISSUER=

# The same endpoints spelled out, because Grafana has no discovery. They appear in the
# openid-configuration document as authorization_endpoint, token_endpoint and
# userinfo_endpoint. For Entra ID:
#   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
#   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
#   https://graph.microsoft.com/oidc/userinfo
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# Where signing out sends the browser, listed as end_session_endpoint in the same document.
# Leave it empty and signing out only ends the session here: the provider still has one, and
# the next page view is signed straight back in without anyone being asked anything.
# Give it without a query string -- the scripts source this file, and an "&" in a value
# silently truncates it.
#   Entra ID:   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/logout
OIDC_LOGOUT_URL=

# The client (application) ID. One registration serves both services, told apart by their
# redirect URLs, so people are assigned to roles once instead of once per service. The
# client secret is a podman secret; the cheat sheet has the command to set it.
OIDC_CLIENT_ID=

# Optional, and normally left empty: what to ask the provider for when someone signs in is
# worked out from the issuer above. That is the three standard OpenID Connect scopes, plus
# for Entra ID the permission Microsoft wants before it will part with profile pictures.
# Fill this in only to overrule that -- a tenant that will not grant the extra permission
# refuses the sign-in itself, and asking for the three alone puts it back:
#   openid profile email
OIDC_SCOPES=
