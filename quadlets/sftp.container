# The dropzones SFTP endpoint, published by the pod on SFTP_PORT (see main.pod).
#
# It runs the crudman image in its "sftp" role: a small SFTP server that authenticates
# uploaders against the dropzones and feeds every cleanly finished session into the
# same upload pipeline the browser and API uploads use. Ordering after crudman (plus
# the entrypoint's own wait) makes sure the database migrations are applied first.
# Notify=healthy marks the service started only once the port answers.
[Unit]
Description=${APP_NAME} sftp (dropzones SFTP endpoint)
After=crudman.service

[Container]
ContainerName=sftp
Pod=main.pod
Image=${REGISTRY}/crudman:${IMAGE_TAG}
Exec=/crudman/entrypoint.sh sftp
Notify=healthy
# An init at PID 1 forwards the stop signal to the whole process tree and reaps it; see
# crudman.container.
RunInit=true
Environment=APP_NAME=${APP_NAME}
# SERVER_NAME and DEBUG come from the operator's runtime.env; see crudman.container.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB=${PG_DATABASE}
Environment=POSTGRES_USER=${CRUDMAN_DB_USER}
Environment=UPLOADS_DIR=/var/lib/app/uploads
Volume=uploads_data.volume:/var/lib/app/uploads:z
Environment=SFTP_DIR=/var/lib/app/sftp
Volume=sftp_data.volume:/var/lib/app/sftp:z
# The names of the secrets mounted below, so the code that reads a file back out of
# /run/secrets looks for the same name podman put there (see SECRET_* in buildtime.env).
Environment=SECRET_DJANGO_KEY=${SECRET_DJANGO_KEY}
Environment=SECRET_CRUDMAN_PASSWORD=${SECRET_CRUDMAN_PASSWORD}
Secret=${SECRET_DJANGO_KEY}
Secret=${SECRET_CRUDMAN_PASSWORD}
HealthCmd=python -c 'import os, socket; socket.create_connection(("127.0.0.1", int(os.environ["SFTP_PORT"])), 5).close()'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
# The same probe again as a startup healthcheck, polled every second instead of every ten.
# The endpoint waits for the database and for crudman's migrations, so it can come up at
# any point between two of the regular polls -- and Notify=healthy holds the unit
# "starting" until a poll happens to look. Polling once a second reports it ready as soon
# as it is, without a start period that delays the first look; podman switches to the
# regular interval above after the first success, leaving the steady-state load unchanged.
HealthStartupCmd=python -c 'import os, socket; socket.create_connection(("127.0.0.1", int(os.environ["SFTP_PORT"])), 5).close()'
HealthStartupInterval=1s
HealthStartupTimeout=5s

[Service]
Restart=always

[Install]
WantedBy=default.target
