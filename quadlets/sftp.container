# The dropzones SFTP endpoint, published by the pod on port 2222 (see main.pod).
#
# It runs the crudman image in its "sftp" role: a small SFTP server that authenticates
# uploaders against the dropzones and feeds every cleanly finished session into the
# same upload pipeline the browser and API uploads use. Ordering after crudman (plus
# the entrypoint's own wait) makes sure the database migrations are applied first.
# Notify=healthy marks the service started only once the port answers.
[Unit]
Description=${APP_NAME} sftp (dropzones SFTP endpoint)
After=crudman.service

[Container]
ContainerName=sftp
Pod=main.pod
Image=${REGISTRY}/crudman:${IMAGE_TAG}
Exec=/crudman/entrypoint.sh sftp
Notify=healthy
# An init at PID 1 forwards the stop signal to the whole process tree and reaps it; see
# crudman.container.
RunInit=true
Environment=APP_NAME=${APP_NAME}
# SERVER_NAME and DEBUG come from the operator's runtime.env; see crudman.container.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB=postgres
Environment=POSTGRES_USER=crudman
Environment=UPLOADS_DIR=/var/lib/app/uploads
Volume=uploads_data.volume:/var/lib/app/uploads:z
Environment=SFTP_DIR=/var/lib/app/sftp
Volume=sftp_data.volume:/var/lib/app/sftp:z
Secret=django_secret_key
Secret=crudman_password
HealthCmd=python -c 'import socket; socket.create_connection(("127.0.0.1", 2222), 5).close()'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
# The same probe again as a startup healthcheck, polled every second instead of every
# ten. The endpoint waits for the database and for crudman's migrations, so when it does
# come up it can be at any point between two of the regular ten-second polls -- and
# Notify=healthy holds the unit "starting" until a poll happens to look. Polling once a
# second reports it ready as soon as it is, without a start period that delays the first
# look; after the first success podman switches to the regular interval above, so the
# steady-state load is unchanged.
HealthStartupCmd=python -c 'import socket; socket.create_connection(("127.0.0.1", 2222), 5).close()'
HealthStartupInterval=1s
HealthStartupTimeout=5s

[Service]
Restart=always

[Install]
WantedBy=default.target
