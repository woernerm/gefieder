# The dropzones Arrow Flight endpoint, published by the pod on port 8815 (see main.pod).
#
# It runs the crudman image in its "flight" role: a small Arrow Flight server that
# authenticates uploaders against the dropzones and feeds every committed upload into
# the same pipeline the browser, API and SFTP uploads use. Ordering after crudman (plus
# the entrypoint's own wait) makes sure the database migrations are applied first.
# Notify=healthy marks the service started only once the port answers.
[Unit]
Description=${APP_NAME} flight (dropzones Arrow Flight endpoint)
After=crudman.service

[Container]
ContainerName=flight
Pod=main.pod
Image=${REGISTRY}/crudman:${IMAGE_TAG}
Exec=/crudman/entrypoint.sh flight
Notify=healthy
# An init at PID 1 forwards the stop signal to the whole process tree and reaps it; see
# crudman.container.
RunInit=true
Environment=APP_NAME=${APP_NAME}
# SERVER_NAME and DEBUG come from the operator's runtime.env; see crudman.container.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB=postgres
Environment=POSTGRES_USER=${CRUDMAN_DB_USER}
# Unlike SFTP this endpoint keeps no state of its own — uploads in progress live in the
# container's temporary directory and are deliberately lost on a restart, because an
# upload that was never committed is incomplete.
Environment=UPLOADS_DIR=/var/lib/app/uploads
Volume=uploads_data.volume:/var/lib/app/uploads:z
Secret=django_secret_key
Secret=crudman_password
HealthCmd=python -c 'import socket; socket.create_connection(("127.0.0.1", 8815), 5).close()'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
# The same probe again as a startup healthcheck, polled every second instead of every ten,
# for the reason sftp.container gives: it waits for the database and for crudman's
# migrations, so it can come up at any point between two of the regular polls while
# Notify=healthy holds the unit "starting".
HealthStartupCmd=python -c 'import socket; socket.create_connection(("127.0.0.1", 8815), 5).close()'
HealthStartupInterval=1s
HealthStartupTimeout=5s

[Service]
Restart=always

[Install]
WantedBy=default.target
