# The PostgreSQL database holding the engineering, analytics and application data.
#
# The image install.sh loaded from the release. Notify=healthy ties "service started" to
# the healthcheck below, so units ordered after this one wait for real connections.
[Unit]
Description=${APP_NAME} PostgreSQL database

[Container]
ContainerName=postgresql
Pod=main.pod
Image=${REGISTRY}/postgresql:${IMAGE_TAG}
Notify=healthy
Environment=POSTGRES_DB=${PG_DATABASE}
Environment=POSTGRES_USER=${SUPERUSER_NAME}
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/${SECRET_SUPERUSER_PASSWORD}
# RHEL/Fedora SELinux needs a relabeled volume for rootless podman to mount it.
Volume=postgresql_data.volume:/var/lib/postgresql/data:z
Secret=${SECRET_SUPERUSER_PASSWORD}
Secret=${SECRET_CRUDMAN_PASSWORD}
Secret=${SECRET_SQLMESH_PASSWORD}
Secret=${SECRET_GRAFANA_PASSWORD}
HealthCmd=pg_isready -U ${SUPERUSER_NAME} -d ${PG_DATABASE}
HealthInterval=5s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=10s

[Service]
Restart=always

[Install]
WantedBy=default.target
