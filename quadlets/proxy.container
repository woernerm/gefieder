# The nginx reverse proxy serving the admin panel and Grafana under SERVER_NAME. The
# config is baked into the image, and the entrypoint picks plain HTTP or HTTPS from DEBUG.
# The certificate is the only host-local piece, bind-mounted from CERTIFICATE_PATH.
[Unit]
Description=${APP_NAME} nginx reverse proxy
After=crudman.service grafana.service

[Container]
ContainerName=proxy
Pod=main.pod
Image=${REGISTRY}/proxy:${IMAGE_TAG}
# An init at PID 1 forwards the stop signal to the process tree; see crudman.container.
# nginx's graceful shutdown is SIGQUIT, which the image already declares as its StopSignal.
# No StopSignal= here: that quadlet key exists only from podman 5.2, and an older podman
# skips the whole unit over it.
RunInit=true
# The host's timezone rather than the image's UTC: nginx stamps its error_log in a format
# no directive overrides, and that stamp names no zone.
Timezone=local
# SERVER_NAME and DEBUG come from runtime.env, and the entrypoint picks its template once
# at startup. See crudman.container on why the file must exist.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=CRUDMAN_PATH=${CRUDMAN_PATH}
Environment=GRAFANA_PATH=${GRAFANA_PATH}
Environment=MCP_PATH=${MCP_PATH}
# The certificate directory as it looks on the host, for the entrypoint's message when one
# is missing: inside the container only the mount point is visible. systemd resolves "%h".
Environment=CERTIFICATE_HINT=${CERTIFICATE_PATH}
Volume=${CERTIFICATE_PATH}:/etc/nginx/proxy/certs:ro,z
# nginx writes visits.log here, one JSON line per page navigation, which the collector
# drains by byte offset. Data, not a human log; those go to stdout. RHEL/Fedora SELinux
# needs the relabel for a rootless mount.
Volume=proxy_data.volume:/var/log/app:z
# A real page rather than the process: an unreachable upstream leaves the master running
# while every request is reset. The redirect at "/" is served by the proxy itself, so this
# needs neither crudman nor grafana up.
HealthCmd=wget -q --spider http://127.0.0.1/ || wget -q --spider --no-check-certificate https://127.0.0.1/
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=10s

[Service]
Restart=always
# podman refuses to start a container whose bind source is missing, leaving only a statfs
# error in the journal. Created here rather than in the installer, so "%h" stays with
# systemd. Empty is fine: the entrypoint reports a missing certificate itself.
ExecStartPre=/usr/bin/mkdir -p ${CERTIFICATE_PATH}

[Install]
WantedBy=default.target
