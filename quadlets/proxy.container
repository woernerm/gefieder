# The nginx reverse proxy that serves the admin panel and Grafana under SERVER_NAME.
# The config is baked into the image; the entrypoint picks plain HTTP (DEBUG=true) or
# HTTPS based on the DEBUG value from runtime.env (empty = production). The certificate is
# the only host-local piece, bind-mounted from ~/.config/${APP_NAME}/certs.
[Unit]
Description=${APP_NAME} nginx reverse proxy
After=crudman.service grafana.service

[Container]
ContainerName=proxy
Pod=main.pod
Image=${REGISTRY}/proxy:${IMAGE_TAG}
# An init at PID 1 forwards the stop signal past the entrypoint's tee pipeline; see
# crudman.container for why the shell alone cannot. The proxy is stopped with SIGQUIT,
# nginx's graceful shutdown (its SIGTERM is a fast one that drops open connections): the
# nginx image already declares it as its StopSignal and podman takes it from there, so no
# StopSignal= is set here -- that quadlet key only exists from podman 5.2 on and an older
# podman skips the whole unit over it, leaving the stack running without a proxy.
RunInit=true
# SERVER_NAME and DEBUG come from the operator's runtime.env, so changing either needs no
# rebuild -- only "systemctl --user restart proxy.service", because the entrypoint picks
# the HTTP or HTTPS template once at startup. See crudman.container on why the file must
# exist.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=CRUDMAN_PATH=${CRUDMAN_PATH}
Environment=GRAFANA_PATH=${GRAFANA_PATH}
Volume=%h/.config/${APP_NAME}/certs:/etc/nginx/proxy/certs:ro,z
# Data volume. nginx writes visits.log here: one JSON line per page navigation, which the
# server-statistics collector drains by byte offset into the dashboard_visit table. It is
# data for the collector, not a human log -- those go to stdout and thus journald.
# RHEL/Fedora SELinux needs a relabeled volume for rootless podman to mount it.
Volume=proxy_data.volume:/var/log/app:z
# Fetch a real page rather than checking that the process exists: an unreachable upstream
# leaves the master process running while every request is reset, which "pgrep nginx"
# reported as healthy. The redirect at "/" is served by the proxy itself, so this tests the
# proxy's own health without depending on crudman or grafana being up yet.
HealthCmd=wget -q --spider http://127.0.0.1/ || wget -q --spider --no-check-certificate https://127.0.0.1/
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=10s

[Service]
Restart=always

[Install]
WantedBy=default.target
