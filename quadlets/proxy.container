# The nginx reverse proxy that serves the admin panel and Grafana under SERVER_NAME.
# The config is baked into the image; the entrypoint picks plain HTTP (DEBUG=true) or
# HTTPS based on the DEBUG value from runtime.env (empty = production). The certificate is
# the only host-local piece, bind-mounted from CERTIFICATE_PATH (see buildtime.env).
[Unit]
Description=${APP_NAME} nginx reverse proxy
After=crudman.service grafana.service

[Container]
ContainerName=proxy
Pod=main.pod
Image=${REGISTRY}/proxy:${IMAGE_TAG}
# An init at PID 1 forwards the stop signal to the process tree and reaps it; see
# crudman.container. The proxy stops on SIGQUIT, nginx's graceful shutdown, which the
# image already declares as its StopSignal. No StopSignal= here: that quadlet key exists
# only from podman 5.2 on, and an older podman skips the whole unit over it.
RunInit=true
# Run on the host's timezone rather than the image's UTC. nginx stamps its error_log
# records in a format no directive overrides, and that stamp names no zone -- on UTC it
# reads hours off journald's with nothing to explain the gap.
Timezone=local
# SERVER_NAME and DEBUG come from runtime.env, so changing either needs a restart rather
# than a rebuild: the entrypoint picks the HTTP or HTTPS template once at startup. See
# crudman.container on why the file must exist.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=CRUDMAN_PATH=${CRUDMAN_PATH}
Environment=GRAFANA_PATH=${GRAFANA_PATH}
# The certificate directory as it looks on the host, for the entrypoint's message when the
# certificate is missing. Inside the container only the mount point is visible, which would
# not tell the operator where to put the files. systemd resolves the "%h" here.
Environment=CERTIFICATE_HINT=${CERTIFICATE_PATH}
Volume=${CERTIFICATE_PATH}:/etc/nginx/proxy/certs:ro,z
# nginx writes visits.log here, one JSON line per page navigation, which the collector
# drains by byte offset into dashboard_visit. Data for the collector, not a human log —
# those go to stdout. RHEL/Fedora SELinux needs the relabel for a rootless mount.
Volume=proxy_data.volume:/var/log/app:z
# Fetch a real page rather than checking that the process exists: an unreachable upstream
# leaves the master process running while every request is reset, which "pgrep nginx"
# reported as healthy. The redirect at "/" is served by the proxy itself, so this tests the
# proxy's own health without depending on crudman or grafana being up yet.
HealthCmd=wget -q --spider http://127.0.0.1/ || wget -q --spider --no-check-certificate https://127.0.0.1/
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=10s

[Service]
Restart=always
# Podman refuses to start a container whose bind source is missing, leaving the proxy dead
# with only a statfs error in the journal. Created here rather than in the installer so
# "%h" stays with systemd, the only thing that knows what it means. Empty is fine: the
# entrypoint reports a missing certificate itself.
ExecStartPre=/usr/bin/mkdir -p ${CERTIFICATE_PATH}

[Install]
WantedBy=default.target
