# The Django administration panel, reachable through the proxy.
#
# The image install.sh loaded from the release. The entrypoint waits for the database
# itself, so ordering after postgresql is a hint. Notify=healthy marks the service started
# only once the healthcheck below passes.
[Unit]
Description=${APP_NAME} crudman (Django admin panel)
After=postgresql.service

[Container]
ContainerName=crudman
Pod=main.pod
Image=${REGISTRY}/crudman:${IMAGE_TAG}
Notify=healthy
# Forwards signals to the whole process tree and reaps it, so podman's SIGTERM reaches
# gunicorn and in-flight requests drain rather than being SIGKILLed at the stop timeout.
RunInit=true
# The host's timezone rather than the image's UTC, so gunicorn's own stamp agrees with
# journald's. The sftp and flight containers need none: Django's logging emits no stamp.
Timezone=local
Environment=APP_NAME=${APP_NAME}
# SERVER_NAME and DEBUG come from runtime.env, so changing either needs a restart rather
# than a rebuild. podman rejects a missing env file, and systemd's optional "-" prefix does
# not help: quadlet passes the path to --env-file, which takes it literally.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=SUPERUSER_NAME=${SUPERUSER_NAME}
Environment=SUPERUSER_EMAIL=${SUPERUSER_EMAIL}
Environment=CRUDMAN_PATH=${CRUDMAN_PATH}
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB=${PG_DATABASE}
Environment=POSTGRES_USER=${CRUDMAN_DB_USER}
# The prefix on the login roles crudman provisions (DB_USER_PREFIX in buildtime.env).
Environment=DB_USER_PREFIX=${DB_USER_PREFIX}
# The engine's role, which the models migration grants the one table it has to write: the
# deployment row it closes once it has planned a commit.
Environment=SQLMESH_DB_USER=${SQLMESH_DB_USER}
# The prefix on the rank names. Only this container signs anyone in or provisions an
# account.
Environment=ROLE_PREFIX=${ROLE_PREFIX}
# Shared read-only with sqlmesh at the same path, so the paths stored in the database
# resolve there too.
Environment=UPLOADS_DIR=/var/lib/app/uploads
Volume=uploads_data.volume:/var/lib/app/uploads:z
# The analytics models. crudman is the only writer: it clones REPO_MODELS here, checks a
# commit out under deployed/ and hosts the bare origin when REPO_MODELS is the local
# default. sqlmesh mounts the same volume read-only at the same path, so a path recorded
# here resolves there.
Environment=MODELS_DIR=/var/lib/app/models
Volume=models_data.volume:/var/lib/app/models:z
# Where the models come from (buildtime.env). A local path is a repository crudman creates
# and seeds; anything else is cloned and polled as the origin.
Environment=REPO_MODELS=${REPO_MODELS}
# So the code reading a file back out of /run/secrets looks for the name podman put
# there (see SECRET_* in buildtime.env).
Environment=SECRET_DJANGO_KEY=${SECRET_DJANGO_KEY}
Environment=SECRET_CRUDMAN_PASSWORD=${SECRET_CRUDMAN_PASSWORD}
Environment=SECRET_SUPERUSER_PASSWORD=${SECRET_SUPERUSER_PASSWORD}
Environment=SECRET_OIDC_CLIENT=${SECRET_OIDC_CLIENT}
Secret=${SECRET_DJANGO_KEY}
Secret=${SECRET_CRUDMAN_PASSWORD}
Secret=${SECRET_SUPERUSER_PASSWORD}
# A placeholder while OIDC_ENABLED is false, but podman will not start a container whose
# Secret= is missing.
Secret=${SECRET_OIDC_CLIENT}
# Any answer below 500 counts as healthy, and redirects are not followed: the panel
# redirects when nobody is signed in, and following it would test the identity provider.
# Single-quoted, quadlet mangling the closing quote of a double-quoted HealthCmd.
HealthCmd=python -c 'import http.client,os; c=http.client.HTTPConnection("127.0.0.1",8000,timeout=5); c.request("GET","/"+os.environ["CRUDMAN_PATH"]+"/"); raise SystemExit(0 if c.getresponse().status<500 else 1)'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
# The same probe every second at startup: migrations, collectstatic and the superuser
# update run before gunicorn binds, so readiness lands at an unpredictable point and
# Notify=healthy would wait out a whole interval. podman reverts after the first success.
HealthStartupCmd=python -c 'import http.client,os; c=http.client.HTTPConnection("127.0.0.1",8000,timeout=5); c.request("GET","/"+os.environ["CRUDMAN_PATH"]+"/"); raise SystemExit(0 if c.getresponse().status<500 else 1)'
HealthStartupInterval=1s
HealthStartupTimeout=5s

[Service]
Restart=always

[Install]
WantedBy=default.target
