# The Django administration panel, reachable through the proxy.
#
# The image is the one install.sh loaded from the release. The entrypoint waits for the
# database itself, so ordering after postgresql is a hint rather than a hard requirement.
# Notify=healthy marks the service started only once the healthcheck below passes.
[Unit]
Description=${APP_NAME} crudman (Django admin panel)
After=postgresql.service

[Container]
ContainerName=crudman
Pod=main.pod
Image=${REGISTRY}/crudman:${IMAGE_TAG}
Notify=healthy
# A real init at PID 1 that forwards signals to the whole process tree and reaps it, so
# podman's SIGTERM reaches gunicorn and in-flight requests drain instead of being cut off
# by the SIGKILL that ends a timed-out stop.
RunInit=true
Environment=APP_NAME=${APP_NAME}
# SERVER_NAME and DEBUG come from the operator's runtime.env, so changing either needs a
# restart rather than a rebuild. The installer writes the file before the units start;
# podman rejects a missing env file, and systemd's optional "-" prefix is not supported
# here -- quadlet passes the path to --env-file, which takes it literally.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=SUPERUSER_NAME=${SUPERUSER_NAME}
Environment=SUPERUSER_EMAIL=${SUPERUSER_EMAIL}
Environment=CRUDMAN_PATH=${CRUDMAN_PATH}
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB=postgres
Environment=POSTGRES_USER=crudman
# The dropzones uploads. Shared read-only with the sqlmesh container at the same path,
# so the file paths stored in the database resolve there too.
Environment=UPLOADS_DIR=/var/lib/app/uploads
Volume=uploads_data.volume:/var/lib/app/uploads:z
Secret=django_secret_key
Secret=crudman_password
Secret=superuser_password
# Single-quoted -c argument: quadlet mangles the closing quote of a double-quoted
# HealthCmd, so the inner strings use "..." and the whole argument is single-quoted.
HealthCmd=python -c 'import os,urllib.request; urllib.request.urlopen("http://127.0.0.1:8000/"+os.environ["CRUDMAN_PATH"]+"/").read()'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
# The same probe again as a startup healthcheck, polled every second instead of every ten.
# Migrations, collectstatic and the superuser update run before gunicorn binds, so readiness
# lands at an unpredictable point; without this, Notify=healthy waits out the start period
# and then up to a full interval before the first look. Polling once a second reports the
# panel ready as soon as it answers; podman switches to the regular interval above after the
# first success, leaving the steady-state load unchanged.
HealthStartupCmd=python -c 'import os,urllib.request; urllib.request.urlopen("http://127.0.0.1:8000/"+os.environ["CRUDMAN_PATH"]+"/").read()'
HealthStartupInterval=1s
HealthStartupTimeout=5s

[Service]
Restart=always

[Install]
WantedBy=default.target
