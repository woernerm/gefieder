# The Django administration panel, reachable through the proxy.
#
# The image is the one install.sh loaded from the release. The entrypoint waits for the
# database itself, so ordering after postgresql is a hint rather than a hard requirement.
# Notify=healthy marks the service started only once the healthcheck below passes.
[Unit]
Description=${APP_NAME} crudman (Django admin panel)
After=postgresql.service

[Container]
ContainerName=crudman
Pod=main.pod
Image=${REGISTRY}/crudman:${IMAGE_TAG}
Notify=healthy
# A real init at PID 1 that forwards signals to the whole process tree and reaps it, so
# podman's SIGTERM reaches gunicorn and in-flight requests drain instead of being cut off
# by the SIGKILL that ends a timed-out stop.
RunInit=true
# Run on the host's timezone rather than the image's UTC, so gunicorn's own stamp agrees
# with journald's beside it. The sftp and flight containers run this image without the
# setting: Django's logging emits no timestamp, so there is nothing to align.
Timezone=local
Environment=APP_NAME=${APP_NAME}
# SERVER_NAME and DEBUG come from runtime.env, so changing either needs a restart rather
# than a rebuild. The installer writes the file before the units start; podman rejects a
# missing env file, and systemd's optional "-" prefix does not work here — quadlet passes
# the path to --env-file, which takes it literally.
EnvironmentFile=%h/.config/${APP_NAME}/runtime.env
Environment=SUPERUSER_NAME=${SUPERUSER_NAME}
Environment=SUPERUSER_EMAIL=${SUPERUSER_EMAIL}
Environment=CRUDMAN_PATH=${CRUDMAN_PATH}
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB=${PG_DATABASE}
Environment=POSTGRES_USER=${CRUDMAN_DB_USER}
# The prefix on the roles crudman provisions for administrators, so the names it builds
# match the group roles the database created (see DB_ROLE_PREFIX in buildtime.env).
Environment=DB_ROLE_PREFIX=${DB_ROLE_PREFIX}
# The prefix on the Django groups a provider rank grants, and the one on the per-tenant
# bronze schemas, which is how the admin finds tenants in the catalog. Only this container
# needs either: the sftp and flight roles neither sign anyone in nor onboard a tenant.
Environment=SSO_GROUP_PREFIX=${SSO_GROUP_PREFIX}
Environment=BRONZE_SCHEMA_PREFIX=${BRONZE_SCHEMA_PREFIX}
# The dropzones uploads. Shared read-only with the sqlmesh container at the same path,
# so the file paths stored in the database resolve there too.
Environment=UPLOADS_DIR=/var/lib/app/uploads
Volume=uploads_data.volume:/var/lib/app/uploads:z
# The names of the secrets mounted below, so the code that reads a file back out of
# /run/secrets looks for the same name podman put there (see SECRET_* in buildtime.env).
Environment=SECRET_DJANGO_KEY=${SECRET_DJANGO_KEY}
Environment=SECRET_CRUDMAN_PASSWORD=${SECRET_CRUDMAN_PASSWORD}
Environment=SECRET_SUPERUSER_PASSWORD=${SECRET_SUPERUSER_PASSWORD}
Environment=SECRET_OIDC_CLIENT=${SECRET_OIDC_CLIENT}
# The analytics role's password, so the chart panels can query the medallion layers as
# the very role Grafana uses and get the same answers. It is read-only on everything it
# can reach, which is what makes a panel's stored SQL safe to run.
Environment=SECRET_GRAFANA_PASSWORD=${SECRET_GRAFANA_PASSWORD}
Environment=GRAFANA_DB_USER=${GRAFANA_DB_USER}
Secret=${SECRET_DJANGO_KEY}
Secret=${SECRET_CRUDMAN_PASSWORD}
Secret=${SECRET_SUPERUSER_PASSWORD}
Secret=${SECRET_GRAFANA_PASSWORD}
# A placeholder while OIDC_ENABLED is false, but must exist: podman will not start a
# container whose Secret= is missing.
Secret=${SECRET_OIDC_CLIENT}
# Any answer below 500 counts as healthy, and redirects are not followed: the panel
# redirects when nobody is signed in, and a probe that followed it would test the identity
# provider rather than this container. Single-quoted -c argument, because quadlet mangles
# the closing quote of a double-quoted HealthCmd.
HealthCmd=python -c 'import http.client,os; c=http.client.HTTPConnection("127.0.0.1",8000,timeout=5); c.request("GET","/"+os.environ["CRUDMAN_PATH"]+"/"); raise SystemExit(0 if c.getresponse().status<500 else 1)'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
# The same probe as a startup healthcheck, polled every second. Migrations, collectstatic
# and the superuser update run before gunicorn binds, so readiness lands at an
# unpredictable point and Notify=healthy would otherwise wait out the start period plus an
# interval. Podman switches to the regular interval after the first success.
HealthStartupCmd=python -c 'import http.client,os; c=http.client.HTTPConnection("127.0.0.1",8000,timeout=5); c.request("GET","/"+os.environ["CRUDMAN_PATH"]+"/"); raise SystemExit(0 if c.getresponse().status<500 else 1)'
HealthStartupInterval=1s
HealthStartupTimeout=5s

[Service]
Restart=always

[Install]
WantedBy=default.target
