# The notebook servers' homes and the hub's own state.
#
# Each person's home holds their kernel settings, their git credential store and their
# Lab layout. The hub's sqlite database beside it records who has signed in and which
# servers are running.
#
# Nothing here is the only copy of anything: the work lives in the workspaces on
# models_data, and what matters has been pushed. Removing this volume costs a re-login.
[Volume]
VolumeName=jupyter_data
